ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-project.vercel.app

# Phase 1 spike 4 (docs/IMPLEMENTATION_PLAN.md §6) -- Canvas feasibility only.
# Never commit real values. Generate CANVAS_ACCESS_TOKEN yourself at
# <your-canvas-domain>/profile/settings -> Approved Integrations -> New Access Token.
# Per I4, this token is used only against the narrowed allowlist (syllabus text
# and module/topic titles) -- never assignments, quizzes, discussions, or submissions.
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_ACCESS_TOKEN=

